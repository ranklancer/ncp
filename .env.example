# Copy this file to .env and fill in your backend URLs.
# NCP reads these at startup and substitutes them into ncp.config.yaml.

# Optional server overrides (defaults: 0.0.0.0:8100)
# NCP_HOST=0.0.0.0
# NCP_PORT=8100

# Backend MCP server URLs — StreamableHTTP endpoint (e.g. http://host:port/mcp)
DOCKGE_MCP_URL=http://127.0.0.1:XXXX/mcp
TRUENAS_MCP_URL=http://127.0.0.1:XXXX/mcp
NPM_MCP_URL=http://127.0.0.1:XXXX/mcp
GITHUB_MCP_URL=http://127.0.0.1:XXXX/mcp
VAULTWARDEN_MCP_URL=http://127.0.0.1:XXXX/mcp
HOMEPAGE_MCP_URL=http://127.0.0.1:XXXX/mcp
CLOUDFLARE_MCP_URL=http://127.0.0.1:XXXX/mcp
N8N_MCP_URL=http://127.0.0.1:XXXX/mcp
